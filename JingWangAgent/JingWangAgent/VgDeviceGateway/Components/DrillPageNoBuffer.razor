    private async Task SetExternalMaterial()
    {
        OutputMessage($"SetExternalMaterial 方法开始执行：");
        if (string.IsNullOrEmpty(rearDrill2849Context.ItemCode))
        {
            OutputMessage("请输入物料代码");
            return;
        }
        // if (rearDrill2849Context.Pcs == 0)
        // {
        //     OutputMessage("请输入板料片数");
        //     return;
        // }
        if (deviceProvider.Devices.Count == 1)
        {
            var device = deviceProvider.Devices[0] as DefaultDrill;
            int splineNum = rearDrill2849Context.SelectSplineNum;
            // var panelCodes = await httpRequestInvoker.GetFromJsonAsync<List<string>>(string.Format(device.DeviceDescriptor.Extra["GetNextPanelNumber"].ToStr(), splineNum));
            // List<Panel> panels = new List<Panel>();
            int startSpline = rearDrill2849Context.StartSpline;
            var productStatus = ProductStatus.EmptySiloBox;
            if (rearDrill2849Context.PanelLayer == 0)
            {
                productStatus = ProductStatus.WaitingForDrill;
            }
            else if (rearDrill2849Context.PanelLayer == 1)
            {
                productStatus = ProductStatus.Drilling;
            }
            else if (rearDrill2849Context.PanelLayer == 2)
            {
                productStatus = ProductStatus.Finished_DRILL;
            }

            var request = new GetDrillNextPanelRequest()
            {
                Layer = rearDrill2849Context.PanelLayer,
                Count = splineNum,
                ItemCode = rearDrill2849Context.ItemCode,
                PinOffset = rearDrill2849Context.PinOffset,
                ProductStatus = productStatus,
                BeginPosition = startSpline,
            };

            logger.LogDebug($"Layer: {rearDrill2849Context.PanelLayer},Count: {splineNum},ItemCode: {rearDrill2849Context.ItemCode},调用GetNextPanelNumberV2接口 参数:{System.Text.RegularExpressions.Regex.Unescape(JsonSerializer.Serialize(request))}");
            var panelLst = await httpRequestInvoker.PostAsJsonAsync<GetDrillNextPanelRequest, List<Panel>>(device.DeviceDescriptor.Extra["GetNextPanelNumberV2"].ToStr(), request);
            logger.LogDebug($"Layer: {rearDrill2849Context.PanelLayer},Count: {splineNum},ItemCode: {rearDrill2849Context.ItemCode},调用GetNextPanelNumberV2接口 返回数据是:{System.Text.RegularExpressions.Regex.Unescape(JsonSerializer.Serialize(panelLst))}");

            if (panelLst == null)
            {
                OutputMessage("请稍候，未能重新生成板料信息");
                return;
            }
            else if (panelLst.Count < splineNum)
            {
                OutputMessage($"请重试。生成的数量【{panelLst.Count}】与需要的数量【{splineNum}】,不一致，");
                return;
            }

            foreach(var panel in panelLst)
            {
                panel.SiloCode = "";
                panel.LotId = "";
                panel.LocationCode = device.DeviceId;
                panel.PinOffset = rearDrill2849Context.PinOffset;
            }

            // for (int i = 0; i < splineNum; i++)
            // {
            //     var panelInf = Guid.NewGuid().ToString();
            //     if (panelCodes != null && panelCodes.Count > i)
            //     {
            //         panelInf = panelCodes[i];
            //     }
            //     panels.Add(new Panel()
            //         {
            //             PanelCode = panelInf,//$"202310000000{i + 1}",
            //             ItemCode = rearDrill2849Context.ItemCode,
            //             ProductStatus = productStatus,
            //             SiloCode = "",
            //             Pcs = rearDrill2849Context.Pcs,
            //             Layer = 1,
            //             Position = startSpline + i,
            //             LotId = "",
            //             PanelWidth = rearDrill2849Context.PanelWidth,
            //             PinOffset = rearDrill2849Context.PinOffset,

            //         });
            // }

            RefreshPcsSelect();
            // device.UpdatePayloadPanels(panels);
            await device.UpdatePayloadPanels(panelLst);

            OutputMessage($"SetExternalMaterial 执行结束{Environment.NewLine}\r\n{JsonSerializer.Serialize(device.PayloadPanels)}");

        }
        else
        {
            OutputMessage($"设置不唯一 无法使用 SetExternalMaterial");
        }

    }
    private async Task ClearExternalMaterial()
    {
        OutputMessage($"ClearExternalMaterial 方法开始执行：");
        if (deviceProvider.Devices.Count == 1)
        {
            var device = deviceProvider.Devices[0] as DefaultDrill;
            int splineNum = rearDrill2849Context.SelectSplineNum;
            List<Panel> panels = new List<Panel>();
            int startSpline = rearDrill2849Context.StartSpline;
            for (int i = 0; i < splineNum; i++)
            {
                panels.Add(new Panel()
                    {
                        PanelCode = "",
                        ItemCode = "",
                        ProductStatus = ProductStatus.EmptySiloBox,
                        SiloCode = "",
                        Layer = rearDrill2849Context.PanelLayer,
                        Position = startSpline + i,
                        LotId = "",
                        Pcs = 0,
                        PanelWidth = 0f,
                        PanelLength = 0f,
                        PinOffset = 0f
                    });
            }
            await device.UpdatePayloadPanels(panels);
            OutputMessage($"ClearExternalMaterial 函数 {Environment.NewLine}\r\n{JsonSerializer.Serialize(device.PayloadPanels)}");

        }
        else
        {
            OutputMessage($"设置不唯一 无法使用 ClearExternalMaterial");
        }

    }
