    private async void ReloadMaterialCodes()
    {
        rearDrill2849Temp.MaterialMatchCode = rearDrill2849Context.MaterialMatchCode;
        await rearDrill2849Temp.GetPanelItemCodeAsync((QueryOrderByEnum)rearDrill2849Context.ItemOrder, rearDrill2849Context.MaterialMatchCode);
        _rhModel = rearDrill2849Temp.MaterialModels;

        OutputMessage($"获取物料代码成功，当前排序方式：{((QueryOrderByEnum)rearDrill2849Context.ItemOrder).ToString()}");
        RefreshSelect();
    }
