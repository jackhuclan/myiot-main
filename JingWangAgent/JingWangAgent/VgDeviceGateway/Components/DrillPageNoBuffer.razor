<EditForm Model="@rearDrill2849Context">
    <table>
        <tr>
            <td><label>请选择板材类别</label></td>
            <td>
                <InputSelect @bind-Value=@rearDrill2849Context.PanelLayer>
                    <option value="0">生料</option>
                    <option value="1" selected>加工中</option>
                    <option value="2">熟料</option>
                </InputSelect>
            </td>
        </tr>
        <tr>
            <td><label>请选择开始轴</label></td>
            <td>
                <InputSelect @bind-Value=@rearDrill2849Context.StartSpline>
                        @for (var i = 0; i < rearDrill2849Temp?.spindleNum; i++)
                        {
                        <option value="@(i+1)">@(i + 1)号轴</option>
                        }
                </InputSelect>
            </td>
        </tr>
        <tr>
            <td>
                <label>设置轴个数</label>
            </td>
            <td>
                <InputNumber @bind-Value=@rearDrill2849Context.SelectSplineNum style="1" Min="1" Editable="false" @bind-Max=@rearDrill2849Context.SelectSplineNumMax></InputNumber>
            </td>
        </tr>
        <tr>
            <td><label>请输入物料代码</label></td>
            <td>
                <InputSelect @bind-Value=@rearDrill2849Context.ItemCode @key="someKey" style="width:100%;">
                        @if (_rhModel != null)
                        {
                            @foreach (var rh in _rhModel)
                            {
                            <option value="@rh.Code">@rh.Code</option>
                            }
                        }
                </InputSelect>
            </td>

            <td style="padding-left: 10px;">
                <InputSelect @bind-Value=@rearDrill2849Context.ItemOrder>
                    <option value="2" selected>按创建时间倒序</option>
                    <option value="3">按物料代码正序</option>
                    <option value="4">按物料代码倒序</option>
                </InputSelect>
            </td>
            <td style="padding-left:10px" align="right"><label>模糊匹配: </label></td>
            <td> <InputText @bind-Value=@rearDrill2849Context.MaterialMatchCode></InputText></td>
            <td style="padding-left: 10px;">
                <button @onclick="ReloadMaterialCodes">
                    刷新物料
                </button>

            </td>
        </tr>
        <tr>
            <td>
                <label>板料宽度</label>
            </td>
            <td>
                <InputNumber @bind-Value=@rearDrill2849Context.PanelWidth Min="0" @bind-Max=@bardMaxLength></InputNumber>
            </td>

        </tr>
        <tr>
            <td>
                <label>板料片数</label>
            </td>
            <td>
                <InputNumber @key="someKeyRefreshPcs" @bind-Value=@rearDrill2849Context.Pcs Min="0"></InputNumber>
            </td>

        </tr>

        <tr>
            <td>
                <label>板料销钉距中心偏移量</label>
            </td>
            <td>
                <InputNumber @bind-Value=@rearDrill2849Context.PinOffset></InputNumber>
            </td>
        </tr>
    </table>
</EditForm>
