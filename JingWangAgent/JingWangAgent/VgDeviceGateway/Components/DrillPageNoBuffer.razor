    public class RearDrill2849Context
    {
        public int splineNum { get; set; } = 1;
        public string codeMessage { get; set; } = string.Empty;
        public string MaterialMatchCode { get; set; } = string.Empty;
        public string ItemCode { get; set; } = string.Empty;
        private float _PanelWidth = 622f;
        public int splineInteractiveBehavior { get; set; } = 0;
        public int Pcs { get; set; } = 0;

        public float PanelWidth
        {
            get { return _PanelWidth; }
            set
            {
                if (value > bardMaxLength)
                {
                    _PanelWidth = bardMaxLength;
                }
                else
                {
                    _PanelWidth = value;
                }
            }
        }

        public float PinOffset { get; set; } = 3.2f;
        private int _StartSpline = 1;

        public int StartSpline
        {
            get { return _StartSpline; }
            set
            {
                _StartSpline = value;
                SelectSplineNum = 1;
                SelectSplineNumMax = num - value + 1;
            }
        }

        private int _SelectSplineNum = 1;

        public int SelectSplineNum
        {
            get { return _SelectSplineNum; }
            set
            {
                if (value > SelectSplineNumMax)
                {
                    _SelectSplineNum = 1;
                }
                else
                {
                    _SelectSplineNum = value;
                }
            }
        }

        public int SelectSplineNumMax { get; set; } = num;
        public int PanelLayer { get; set; } = 0;//0buffer上层  1钻机上 2buffer下层
        public int ItemOrder { get; set; } = 2;

    }
