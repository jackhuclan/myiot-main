@using VgAutoDrill.OpenAPI
@using VgDeviceGateway.Devices.Common;
@using VgAutoDrill.Fundation.Iot;
@using System.Text.Json;
@using VgAutoDrill.Fundation.Mqtt;
@using VgDeviceGateway.Devices.Drill;
@using VgDeviceGateway.Devices;
@using VgAutoDrill.Fundation.Iot.Models;
@using VgAutoDrill.Fundation.Utils;
@using System.Threading;
@inject ILogger<DefaultDrill> logger
@inject IDeviceProvider deviceProvider
@inject IJSRuntime JSRuntime;
@inject IHttpRequestInvoker httpRequestInvoker;
@inject IConfiguration configuration

<h3>RearDrill2849Page---<span id="deviceId"></span></h3>
<h3>呼叫条件显示---<span id="callcondition"></span></h3>
<h3>呼叫函数返回信息---<span id="callResult"></span></h3>
<h5>呼叫函数小于时间信息---<span id="callTimeResult"></span></h5>
<h5>buffer整个上下料是否结束---<span id="endResult"></span></h5>

<text>钻机呼叫事件信息：</text>
<br />
<h4 id="transtext">@TransactionId</h4>
<table style="border:solid 2px;">
    <tr style="border:solid 2px;">
        <th style="border:solid 2px;"> transId类型 </th>
        <th style="border:solid 2px;"> transId 值 </th>
    </tr>
    <tr style="border:solid 1px;">
        <td style="border:solid 1px;">生料transId</td>
        <td style="border:solid 1px;" id="newtranstext">@NewTranscationId</td>
    </tr>
    <tr style="border:solid 1px;">
        <td style="border:solid 1px;">钻机transId</td>
        <td style="border:solid 1px;" id="drilltranstext">@DrillTransactionId</td>
    </tr>
    <tr style="border:solid 1px;">
        <td style="border:solid 1px;">熟料transId</td>
        <td style="border:solid 1px;" id="oldtranstext">@OldTransactionId</td>
    </tr>
</table>

<br />
<p>
    <EditForm Model="@rearDrill2849Context">

        <InputSelect @bind-Value=@rearDrill2849Context.splineNum>
            @for (var i = 0; i < rearDrill2849Temp?.spindleNum; i++)
            {
                <option value="@(i+1)">@(i + 1)号轴</option>
            }
        </InputSelect>&nbsp;&nbsp;
        <InputSelect @bind-Value=@rearDrill2849Context.RegionNum>
            <option value="1">1号区域</option>
            <option value="2">2号区域</option>
            <option value="3">3号区域</option>
        </InputSelect>
    </EditForm>
</p>

<p id="text">@message</p>

<p>
    <button @onclick="PrepareLoadMaterial">
        上料前准备
    </button>
    <button @onclick="InvokeLoadMaterial">
        上料
    </button>
    <button @onclick="CompleteLoadMaterial">
        上料完成
    </button>

    <button @onclick="CompleteAllLoadMaterial">
        上料全部完成
    </button>
    <br />
    <br />
    <button @onclick="PrepareUnloadMaterial">
        下料前准备
    </button>
    <button @onclick="InvokeUnloadMaterial">
        下料
    </button>
    <button @onclick="CompleteUnloadMaterial">
        下料完成
    </button>
    <button @onclick="CompleteAllUnloadMaterial">
        下料全部完成
    </button>


    <button @onclick="PropertiesRead" hidden>
        读属性
    </button>
    <br />
    <br />


    <button @onclick="ReadPanels">
        查看料仓信息
    </button>

    <button @onclick="ReadProperties">
        查看属性信息
    </button>

    <button @onclick="BufferUnLoadAndLoadEndFlag" hidden>
        Buffer给钻机上料完成
    </button>

    <button @onclick="DrillFinish" hidden>
        钻机打板结束
    </button>
    <br />
    <br />
    <button @onclick="CompleteAllEnd">
        Agv给Buffer上下料全部完成
    </button>
<p id="mode">@mess</p>
<br />
<br />

