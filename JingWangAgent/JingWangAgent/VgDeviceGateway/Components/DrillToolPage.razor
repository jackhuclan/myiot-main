        <text>轴4使用:</text>
    <input id="broken4" type="checkbox" @onclick="ChangeSpline4BrokenStatus" @bind="spline4checked" style="margin :10px" />
    <br />
    }

    @if (rearDrill2849Temp.DeviceDescriptor.SpindleNum.ToInt() >= 5)
