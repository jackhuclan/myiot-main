    private async void ChangeSpline1BrokenStatus()
    {
        logger.LogDebug("FrontDrill ChangeSplineBrokenStatus...");
        OutputMessage($"ChangeSplineBrokenStatus 函数 开始执行");

    
        if (deviceProvider.Devices.Count == 1)
        {
            var device = deviceProvider.Devices[0] as FrontDrill;
            var charArray = device.SplineNoBrokenStatus.ToCharArray();
            charArray[0] = spline1checked ? '1' : '0';
            device.SplineNoBrokenStatus = new string(charArray);
            OutputMessage($"ChangeSpline1BrokenStatus 函数 开始执行 结束  {spline1checked}{device.SplineNoBrokenStatus}");
        }
        else
        {
            OutputMessage($"没有可用的设备或者设备不唯一");
        }
    }

