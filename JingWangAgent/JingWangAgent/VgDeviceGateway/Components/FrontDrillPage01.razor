<EditForm Model="@frontDrill1ParkingPageTempContext">
    @foreach (var item in @frontDrill1ParkingPageTempContext.splineSelectContexts)
    {
        <InputRadioGroup Name="@item.SplineSelectName" @bind-Value="@item.SplineSelectValue">
            <text> @item.SplineNum 号轴: </text>
            <InputRadio Name="@item.SplineSelectName" Value="1" />生料
            <InputRadio Name="@item.SplineSelectName" Value="-1" />熟料
            <InputRadio Name="@item.SplineSelectName" Value="0" />无料
        </InputRadioGroup>
        <br />
    }  
    <button @onclick="EnsureMetarial"> 确认板材信息</button>
</EditForm>

<br />
<br />
