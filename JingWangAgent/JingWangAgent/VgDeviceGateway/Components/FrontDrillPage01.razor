@using VgDeviceGateway.Devices.Common;
@using VgDeviceGateway.Devices.FrontCNC84Drill;
@using VgAutoDrill.Fundation.Iot;
@using VgAutoDrill.Fundation.Utils;
@using VgAutoDrill.Fundation.Iot.Models;
@inject ILogger<FrontDrill> logger
@inject IDeviceProvider deviceProvider
@inject IJSRuntime JSRuntime;
@inject IConfiguration configuration

<h3>FrontDrillPage---<span id="deviceId"></span></h3>
<h3>呼叫条件显示---<span id="callcondition"></span></h3>
<h3>呼叫函数返回信息---<span id="callResult"></span></h3>
<h5>呼叫函数小于时间信息---<span id="callTimeResult"></span></h5>


<p>
    <EditForm Model="@frontDrill1ParkingPageTempContext">
        <InputSelect @bind-Value=@frontDrill1ParkingPageTempContext.splineNum>
            @for (var i = 1; i <= DrillDevice.DeviceDescriptor.SpindleNum.ToInt(); i++)
            {
                <option value="@i">@(i)号轴</option>
            }
        </InputSelect>&nbsp;&nbsp;
    </EditForm>
    <br />

    <button @onclick="PutUpStatus">
        查询顶升状态
    </button>
    &nbsp; &nbsp;
    <button @onclick="SetPutUpUp">
        顶升升起
    </button>
    &nbsp; &nbsp;
    <button @onclick="SetPutUpDown">
        顶升降下
    </button>
</p>
<p id="text">@message</p>

<p>
    <button @onclick="PrepareLoadMaterial">
        上料前准备
    </button>
   
    <button @onclick="CompleteLoadMaterial">
        上料完成
    </button>

    <button @onclick="CompleteAllLoadMaterial">
        上料全部完成
    </button>
    <br />
    <br />
    <button @onclick="PrepareUnloadMaterial">
        下料前准备
    </button>
    <button @onclick="CompleteUnloadMaterial">
        下料完成
    </button>
    <button @onclick="CompleteAllUnloadMaterial">
        下料全部完成
    </button>
   
    <br />
    <br />
    <button @onclick="CompleteLoadMaterial">
        上料完成
    </button>
    &nbsp; &nbsp;
    <button @onclick="CompleteAllLoadMaterial">
        上料全部完成
    </button>
    <br />
    <br />

    <button @onclick="PutUpAllStatus">
        查询 所有顶升状态
    </button>
    <br />
</p>
<br />
<p>
    <button @onclick="QueryExternalMaterial">
        查询料仓信息
    </button>
</p>
<br />
<p>
    <button @onclick="CallAgv">
        手动发起呼叫
    </button>
</p>


板材信息确认
<br />

