    private void SetTransIdMessage(string id, string message)
    {
        this.JSRuntime.InvokeVoidAsync("UpdateInf", id, message);
    }
    private void SetCheckIdMessage(string id, bool check)
    {
        this.JSRuntime.InvokeVoidAsync("CheckInf", id, check);
    }
    public class FrontDrill1ParkingPageTempContext
    {
        public int splineNum { get; set; } = 1;
