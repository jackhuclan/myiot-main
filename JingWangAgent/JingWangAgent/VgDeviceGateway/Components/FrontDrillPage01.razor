    private async void QueryExternalMaterial()
    {
        //ShowPanel($"检测门是否已打开，或者气压是否正常：{await DrillDevice.ValidateDoorOpen()} \r\n料仓信息：{JsonSerializer.Serialize(DrillDevice.PayloadPanels)}", true);
    }

    private async void ShowPanel(string message, bool reset = false)
    {
        if (reset) currentContext.Message = $"{message}--{DateTime.Now.ToLocalTime()}";
        else currentContext.Message = $"{currentContext.Message}{Environment.NewLine}{message}--{DateTime.Now.ToLocalTime()}";

        await this.JSRuntime.InvokeVoidAsync("handleRequestMaterial", messageElement, currentContext.Message);
    }

    FrontDrill DrillDevice;
    protected override void OnInitialized()
    {
        var deviceId = configuration.GetValue<string>("PageMasterDeviceId");
        DrillDevice = deviceProvider.GetDevice(deviceId) as FrontDrill;
        var splineSelectContexts = new SplineMaterialContext[DrillDevice.spindleNum];
        //init  splineSelectContexts
        {
            for (int i = 1; i <= DrillDevice.spindleNum; i++)
            {
                splineSelectContexts[i - 1] = new SplineMaterialContext()
                    {
                        SplineSelectName = $"Spline{i}Name",
                        SplineNum = i,
                        SplineSelectValue = -1,
                    };
            }
        }
        frontDrill1ParkingPageTempContext.splineSelectContexts = splineSelectContexts.ToList();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        try
        {
            var frontDrill = deviceProvider.Devices[0] as FrontDrill;
            DrillDevice = frontDrill;
            SetTransIdMessage("transtext", frontDrill?.TransactionId);
            SetTransIdMessage("deviceId", frontDrill?.DeviceId);
            SetTransIdMessage("newtranstext", frontDrill?.NewTranscationId);
            SetTransIdMessage("drilltranstext", frontDrill?.DrillTransactionId);
            SetTransIdMessage("oldtranstext", frontDrill?.OldTransactionId);
            SetTransIdMessage("callcondition", frontDrill?.CallCondition);
            SetTransIdMessage("callResult", frontDrill?.callResult);
            SetTransIdMessage("callTimeResult", frontDrill?.callTimeResult);
            var lenth = frontDrill?.spindleNum;
            var charArray = frontDrill?.SplineNoBrokenStatus.ToCharArray();

            if (lenth >= 1) SetCheckIdMessage("broken1", charArray[0] == '1');
            if (lenth >= 2) SetCheckIdMessage("broken2", charArray[1] == '1');
            if (lenth >= 3) SetCheckIdMessage("broken3", charArray[2] == '1');
            if (lenth >= 4) SetCheckIdMessage("broken4", charArray[3] == '1');
            if (lenth >= 5) SetCheckIdMessage("broken5", charArray[4] == '1');
            if (lenth >= 6) SetCheckIdMessage("broken6", charArray[5] == '1');


            this.JSRuntime.InvokeVoidAsync("Refresh");

        }
        catch (Exception e)
        {

            logger.LogDebug($"网页异常 OnAfterRender  {e.Message}");
        }
      


    }
