    private void OutputMessage(string message)
    {
        this.JSRuntime.InvokeVoidAsync("SetText", message);
    }


    private async void EnsureMetarial()
    {
        logger.LogDebug("FrontDrill EnsureMetarial...");
        OutputMessage($"EnsureMetarial 函数 开始执行");
        //
        var splineContext= frontDrill1ParkingPageTempContext.splineSelectContexts;
        DrillDevice.EnsureMetarial(splineContext);

        OutputMessage($"EnsureMetarial 函数执行结果:【完成】");
    }
    private async void CallAgv()
    {
        logger.LogDebug("FrontDrill CallAgv...");
        OutputMessage($"PrepareUnloadMaterial 函数 开始执行");
        var frontDrillEventHandler = DrillDevice.EventContainer[typeof(FrontDrillEventHandler)] as FrontDrillEventHandler;
        var response = await frontDrillEventHandler.CallAgv();
        OutputMessage($"CallAgv 函数执行结果:【{response}】");
    }
    private async void PrepareUnloadMaterial()
    {
        logger.LogDebug("FrontDrill PrepareUnloadMaterial...");
        OutputMessage($"PrepareUnloadMaterial 函数 开始执行");
        if (deviceProvider.Devices.Count == 1)
        {
           var device = deviceProvider.Devices[0]; //("FrontDrill1001");
            var response = await device.PrepareUnloadMaterial(new DeviceServiceInvokeRequest
               {
                   ProductId = device.ProductId,
                   DeviceId = device.DeviceId,
                   ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
                   Params = new Dictionary<string, object?>
                   {

                   }
               });
            OutputMessage($"PrepareUnloadMaterial 函数执行结果:【{response.Code}】 {response.Message}");
        }
        else
        {
           OutputMessage($"没有可用的设备或者设备不唯一");
        }
    }

    private async void CompleteUnloadMaterial()
    {
        logger.LogDebug("FrontDrill CompleteUnloadMaterial...");
        OutputMessage($"CompleteUnloadMaterial 函数 开始执行");
        if (deviceProvider.Devices.Count == 1)
        {
            var device = deviceProvider.Devices[0] ;
            var response = await device.CompleteUnloadMaterial(new DeviceServiceInvokeRequest
                {
                    ProductId = device.ProductId,
                    DeviceId = device.DeviceId,
                    ServiceId = Topics.Services.COMPLETE_UNLOAD_MATERIAL_SERVICE_ID,
                    Params = new Dictionary<string, object?>
                {
                     { "Position",frontDrill1ParkingPageTempContext.splineNum},
                     { "IsLastStep",false},
                }
                });
            OutputMessage($"CompleteUnloadMaterial 函数执行结果:【{response.Code}】{response.Message}");
        }
        else
        {
            OutputMessage($"没有可用的设备或者设备不唯一");
        }

    }

