	private void OutputMessage(string message)
	{
		this.JSRuntime.InvokeVoidAsync("SetText", message);
	}
	private void SetCheckIdMessage(string id,bool check)
	{
		this.JSRuntime.InvokeVoidAsync("CheckInf",id, check);
	}

	private void SetTransIdMessage(string id, string message)
	{
		this.JSRuntime.InvokeVoidAsync("UpdateInf", id, message);
	}

	private void OutputModeMessage(string message)
	{
		this.JSRuntime.InvokeVoidAsync("UpdateInf", "mode", message);
	}
	private async void LoadExternalMaterial()
	{
		OutputMessage($"LoadExternalMaterial 方法开始执行：");
		if (string.IsNullOrEmpty(rearDrill2849Context.ItemCode))
		{
			OutputMessage("请输入物料代码");
			return;
		}
		if (deviceProvider.Devices.Count == 1)
		{
			var device = deviceProvider.Devices[0] as RearDrill2849Duo;
			if (rearDrill2849Context.PanelWidth > device.DeviceDescriptor.Extra["BoardMaxLength"].ToFloat())
			{
				OutputMessage("请输入输入低于或等于625的板宽");
				return;
			}
			var panelCodes = await httpRequestInvoker.GetFromJsonAsync<List<string>>(string.Format(device.DeviceDescriptor.Extra["GetNextPanelNumber"].ToStr(), device.DeviceDescriptor.SpindleNum.ToStr()));
			string clinkerBoardStatus = device.GetClinkerBoardStatus();
			for (var i = 0; i < device.DeviceDescriptor.SpindleNum.ToInt(); i++)
			{
				var panelInf = Guid.NewGuid().ToString();
				if (panelCodes != null && panelCodes.Count > i)
				{
					panelInf = panelCodes[i];
				}
				if (clinkerBoardStatus[i] == '1')
				{
					device.PayloadPanels[i + 2 * device.DeviceDescriptor.SpindleNum] = new Panel
						{
							PanelCode = panelInf,//$"202310000000{i + 1}",
							ItemCode = rearDrill2849Context.ItemCode,
							ProductStatus = ProductStatus.Finished_DRILL,
							SiloCode = $"Silo01",
							Layer = 2,
							Position = i + 1,
							BatchCode = "",
							LotId = "",
							PanelWidth = rearDrill2849Context.PanelWidth,
							PinOffset = rearDrill2849Context.PinOffset,
						};
				}
				else
				{
					device.PayloadPanels[i + 2 * device.DeviceDescriptor.SpindleNum] = null;
				}

			}
			OutputMessage($"板料熟料装载完成{Environment.NewLine}{JsonSerializer.Serialize(device.PayloadPanels)}");

		}
		else
		{
			OutputMessage($"板料熟料装载完成");
		}

	}

	private async void ClearExternalMaterial()
	{
		OutputMessage($"ClearExternalMaterial 方法开始执行：");

		if (deviceProvider.Devices.Count == 1)
		{
			var device = deviceProvider.Devices[0];

			for (var i = 2 * device.DeviceDescriptor.SpindleNum; i < 3 * device.DeviceDescriptor.SpindleNum.ToInt(); i++)
			{
				device.PayloadPanels[i] = null;
			}
			OutputMessage($"板料熟料卸载完成{Environment.NewLine}{JsonSerializer.Serialize(device.PayloadPanels)}");

		}
		else
		{
			OutputMessage($"没有可用的设备或者设备不唯一");
		}

	}

	private async void PrepareLoadMaterial()
	{
		logger.LogDebug("RearDrill2849 PrepareLoadMaterial...");
		OutputMessage($"PrepareLoadMaterial 函数 开始执行");
		if (deviceProvider.Devices.Count == 1)
		{
			var device = deviceProvider.Devices[0] as RearDrill2849Duo;
			var response = await device.PrepareLoadMaterial(new DeviceServiceInvokeRequest
				{
					ProductId = device.ProductId,
					DeviceId = device.DeviceId,
					ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
					Params = new Dictionary<string, object?>
					{
						{ "Position",rearDrill2849Context.splineNum},
						{ "IsLastStep",false}
					}
				});
			OutputMessage($"PrepareLoadMaterial 函数执行结果:【{response.Code}】 {response.Message}");
		}
		else
		{
			OutputMessage($"没有可用的设备或者设备不唯一");
		}

	}
