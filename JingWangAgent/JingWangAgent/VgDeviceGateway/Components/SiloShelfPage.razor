    private async Task QueryProperties()
    {
        var aaa = siloShelf.WatchingProperties.GetValues();
        var allstr = "";
        foreach (var item in aaa)
        {
            allstr += $"{item.Key}:{System.Text.Json.JsonSerializer.Serialize(item.Value, Jsonoptions).Replace("\r\n", "")} \r\n";
        }
        OutputMessage(allstr, true);
        Show(true);

    }

    private async void SearchStatus()
    {
        var aaa = currentContext.isReady;
        OutputMessage("是否是ready状态 ：" + aaa.ToString(), true);
        Show(true);
    }

    private async void SetAllReady()
    {
        var response = await siloShelf.WriteProperties(new DeviceServiceInvokeRequest
        {
            ProductId = siloShelf.ProductId,
            DeviceId = siloShelf.DeviceId,
            ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
        });

        foreach (var location in siloShelf.Locations.Values)
        {
            location.IsReady = true;
            logger.LogInformation($"Trace_Ready : SetAllReady: 人工设置了 {location.LocationCode}  Ready=true");
            location.CurrentContext.isReady = true;
        }

        OutputMessage(response.Message + $"已全部设置Ready", true);
        Show(true);
    }

    private async void SetAllNoReady()
    {
        var response = await siloShelf.WriteProperties(new DeviceServiceInvokeRequest
        {
            ProductId = siloShelf.ProductId,
            DeviceId = siloShelf.DeviceId,
            ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
        });

        foreach (var location in siloShelf.Locations.Values)
        {
            location.IsReady = false;
            logger.LogInformation($"Trace_Ready : SetAllNoReady: 人工设置了 {location.LocationCode}  Ready=false");
            location.CurrentContext.isReady = false;
            await location.CancelSchdule();
        }

        OutputMessage(response.Message + $"已全部取消Ready", true);
        Show(true);
    }

    private async void SetReady()
    {
        var response = await siloShelf.WriteProperties(new DeviceServiceInvokeRequest
        {
            ProductId = siloShelf.ProductId,
            DeviceId = siloShelf.DeviceId,
            ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
        });

        siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].IsReady = true;
        siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].CurrentContext.isReady = true;
        OutputMessage(response.Message + $"是否就绪 {currentContext.isReady}", true);
        Show(true);
    }

    private async void SetNoReady()
    {
        var response = await siloShelf.WriteProperties(new DeviceServiceInvokeRequest
        {
            ProductId = siloShelf.ProductId,
            DeviceId = siloShelf.DeviceId,
            ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
        });

        siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].IsReady = false;
        siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].CurrentContext.isReady = false;
        var cancelScheduleTaskResponse = await siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].CancelSchdule();
        OutputMessage(cancelScheduleTaskResponse?.Message + $"是否就绪 {currentContext.isReady}", true);
        Show(true);
    }

    private async void SetAllCooked()
    {
        siloShelf.Locations[(currentContext.RackIndex + 1).ToStr()].SetAllCookedStatus();
        QueryExternalMaterial();
    }

    private async void CallAgv()
    {
        var message = await siloShelf.ForeCallAgv(currentContext.RackIndex + 1);
        OutputMessage(message, true);
    }
