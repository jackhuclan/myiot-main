    private async void OutputMessage(string message, bool reset = false)
    {
        if (reset) currentContext.Message = $"{message}--{DateTime.Now.ToLocalTime()}";
        else currentContext.Message = $"{currentContext.Message}{Environment.NewLine}{message}--{DateTime.Now.ToLocalTime()}";

        await this.JSRuntime.InvokeVoidAsync("setElementText1", messageElement, currentContext.Message);
    }

    private async void LoadExternalMaterial()
    {
        if (agv.Status == DeviceStatus.Working)
        {
            OutputMessage($"AGV 当前正在执行任务，请稍后再设置", true);
            return;
        }
        AgvPageEntity agvPageEntity = new AgvPageEntity();
        agvPageEntity.AgvId = string.Empty;
        agvPageEntity.AgvName = string.Empty;
        agvPageEntity.MaterialCode = currentContext.ItemCode;
        agvPageEntity.LoadMaterialType = currentContext.PanelType;
        agvPageEntity.StartLayer = currentContext.StartLayer;
        agvPageEntity.LoadLayerCount = currentContext.RawPanelCount;
        agvPageEntity.PanelWidth = currentContext.PanelWidth;
        agvPageEntity.PanelLength = currentContext.PanelLength;
        agvPageEntity.PinOffset = currentContext.PinOffset;
        agvPageEntity.SiloCode = currentContext.SiloCode;
        agvPageEntity.PanelPcs = currentContext.PanelPcs;

        var loadResult = await agv.LoadExternalMaterial(agvPageEntity);
        if (!loadResult.Item1)
        {
            OutputMessage($"加载失败:{loadResult.Item1}_失败信息:{loadResult.Item2}", true);
            return;
        }

        var response = await agv.ReportStatus();
        if (response.Code != ErrorCodes.Sys.SUCCESS)
        {
            OutputMessage("上报状态失败,请检查网络", true);
            Show(false);
        }
        else
        {
            var updateisaotu = await agv.WriteProperties(new DeviceServiceInvokeRequest
                {
                    ProductId = agv.ProductId,
                    DeviceId = agv.DeviceId,
                    ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
                    Params = new Dictionary<string, object?>
                            {
                                {"IsAuto",false }
                            }
                });
            QueryExternalMaterial();
            agv.setNewPanelLog(agvPageEntity);
        }
    }

    private async Task ReloadSiloCodes()
    {
        if (SiloCodes == null)
            SiloCodes = new List<string>();
        else
            SiloCodes.Clear();
        SiloCodes.Add("");

        var siloCodes = await agv.GetSiloCodeAsync(currentContext.SiloMatch);
        SiloCodes.AddRange(siloCodes);
        agv.SiloCodes = SiloCodes;
        OutputMessage("更新料仓编码成功", true);
        InvokeAsync(StateHasChanged);
        Show(true);
    }

