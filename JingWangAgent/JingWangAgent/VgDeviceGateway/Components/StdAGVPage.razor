    void ReadPlc()
    {
        var plcValule = agv.modbusIpMaster.ReadHoldingRegisters(agv.slaveId, currentContext.PlcPoint.ToUshort(), currentContext.PlcLength.ToUshort());
        var outMsg = agv.ReadPlc(plcValule);
        OutputMessage(outMsg, true);
