    private async void MoveToPos()
    {
        try
        {
            // var position = currentContext.ToMovePos.PadLeft(5, '0');
            var position = currentContext.ToMovePos;
            var request = new DeviceServiceInvokeRequest();
            request.Params["MoveTargetPos"] = position;
            request.Params["CheckMovePoint"] = agv.DeviceDescriptor.Extra["CheckMovePoint"];
            request.Params["Unlock"] = true;
            request.Params["count"] = "0";

            if (agv.configExtra["AgvChassisSupplier"].ToStr() == "HikRobot")
            {
                string taskCode = "VegaHik" + DateTime.Now.ToString("yyyyMMddHHmmss");
                request.Params["taskCode"] = taskCode;
                request.Params["reqCode"] = taskCode + "_1";
                agv.publicMoveId = taskCode;
            }

            var newmoveresult = await agv.Move(request);
            var errormsg = string.Format($"Move：AGV移动到点{position}_{newmoveresult.Code}_{newmoveresult.Message}");
            if (newmoveresult.Code != ErrorCodes.Sys.SUCCESS)
            {
                agv.errorInfo = new Tuple<string, string, string>("AGV_Work_MoveNoSuccess", "MoveNoSuccess", errormsg);
                OutputMessage(errormsg);
                return;
            }

            OutputMessage($"移动结果：{newmoveresult.Code}_{newmoveresult.Message}", true);
            Show(true);
        }
        catch (Exception ee)
        {
            OutputMessage($"移动异常：{ee.Message}", true);
        }
    }

