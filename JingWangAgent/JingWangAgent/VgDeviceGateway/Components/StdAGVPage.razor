        var val = currentContext.PlcValue;
        logger.LogInformation($"WritePlc 的值为: {val.ToFloat()}");
        var response = agv.modbusIpMaster.WriteSingleRegisterAsync(1, Convert.ToUInt16(currentContext.PlcPoint), Math.Round(val.ToFloat()).ToUshort());
        OutputMessage($"WritePlc 函数执行结果: {JsonSerializer.Serialize(response)}", true);
        Show(true);
    }

