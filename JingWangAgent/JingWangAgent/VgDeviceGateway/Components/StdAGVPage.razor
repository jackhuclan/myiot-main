<h3>
    @agv.DeviceId - @agv.DeviceName
    <div id="status" style="width:30px;height:30px;display:inline-block;background:url(/images/machine.png);background-size:cover;"></div>
</h3>

<EditForm Model="@currentContext">

    <p>
        <button @onclick="QueryExternalMaterial">
            查询料仓信息
        </button>
        <button @onclick="QueryProperties">
            查看属性信息
        </button>
        <button @onclick="ClearExternalMaterial">
            清空料仓（有料仓 没有料）
        </button>
        <button @onclick="RemoveSilo">
            移除料仓（没有料仓）
        </button>
        <button @onclick="ToFullSilo">
            手动满料仓状态
        </button>
        <button @onclick="SearchActionStatus">
            查看Action状态
        </button>
        <button @onclick="UpdateDone">
            修改为Done，很重要请慎用
        </button>

        <button @onclick="SearchStatus">
            查看设备状态
        </button>
    </p>
    <p>
        <button @onclick="ResetDeviceStatus">
            设备状态重置
        </button>
        <button @onclick="ToException">
            终止设备
        </button>
        <button @onclick="SearchTask">
            查询任务
        </button>
    </p>
    <p>
        <table>
            <tr>
                <td><label>请输入起始层</label></td>
                <td>
                    <InputSelect @bind-Value=@currentContext.StartLayer>
                        @for (var i = 0; i < agv.DeviceDescriptor.LayerLimit.ToInt(); i++)
                        {
                            <option value="@i">@(i + 1)层</option>
                        }
                    </InputSelect>
                </td>

            </tr>
            <tr>
                <td><label>板料类型</label></td>
                <td>
                    <InputSelect @bind-Value=@currentContext.PanelType>
                        <option value="0">空</option>
                        <option value="1">生料</option>
                        <option value="2">熟料</option>
                        <option value="3">已上pin</option>
                        <option value="4">待下pin</option>
                    </InputSelect>
                </td>
            </tr>
            <tr>
                <td><label>请输入物料代码</label></td>
                <td>
                    <InputSelect @bind-Value="currentContext.ItemCode" style="width:100%;">
                        <option value="">请选择物料代码</option> <!-- 默认空选项 -->
                        @if (agv.MaterialModels != null)
                        {
                            @foreach (var rh in agv.MaterialModels)
                            {
                                <option value="@rh.Code">@rh.Code</option>
                            }
                        }
                    </InputSelect>
                </td>
                <td style="margin-left:-10px; color:blue;font-size:30px" align="right"><label>模糊匹配: </label></td>
                <td> <InputText @bind-Value=@currentContext.MaterialMatchCode></InputText></td>
                <td style="color:blue;font-size:30px" align="left"><label>排序: </label></td>
                <td>
                    <InputSelect @bind-Value=@currentContext.ItemOrder>
                        <option value="2" selected>按创建时间倒序</option>
                        <option value="3">按物料代码正序</option>
                        <option value="4">按物料代码倒序</option>
                    </InputSelect>
                </td>
                <td>
                    <button @onclick="ReloadMaterialCodes" style="background-color:#C0C0C0">
                        刷新物料
                    </button>
                </td>
            </tr>
            <tr>
                <td>
                    <label>装载到AGV的生料Panel数量</label>
                </td>
                <td>
                    <InputNumber @bind-Value=@currentContext.RawPanelCount></InputNumber>
                </td>
            </tr>
            <tr>
                <td>
                    <label>装载到AGV的料仓编号</label>
                </td>
                <td>
                    @* <InputText @bind-Value=@currentContext.SiloCode></InputText> *@
                    <InputSelect @bind-Value="currentContext.SiloCode" style="width:100%;">
                        @foreach (var siloCode in agv.SiloCodes)
                        {
                            <option value="@siloCode">@siloCode </option>
                        }
                    </InputSelect>
                </td>
                <td style="padding-left:10px" align="right">
                    <label>料仓匹配:</label>
                </td>
                <td><InputText @bind-Value="currentContext.SiloMatch" style="width:100%;"></InputText></td>
                <td style="padding-left:5px">
                    <button @onclick="ReloadSiloCodes">
                        更新料仓编号
                    </button>
                </td>
            </tr>
            <tr>
                <td>
                    <label>板料每叠片数</label>
                </td>
                <td>
                    <InputNumber @bind-Value=@currentContext.PanelPcs></InputNumber>
                </td>
                <td>
                    <p>请输入没叠片数</p>
                </td>
            </tr>
            <tr>
                <td>
                    <label>板料宽度</label>
                </td>
                <td>
                    <InputNumber @bind-Value=@currentContext.PanelWidth></InputNumber>
                </td>
                <td>
                    <p>请输入低于625的值</p>
                </td>
            </tr>
            <tr>
                <td>
                    <label>板料长度</label>
                </td>
                <td>
                    <InputNumber @bind-Value=@currentContext.PanelLength></InputNumber>
                </td>
                <td>
                    <p>请输入低于999的值</p>
                </td>
            </tr>
        </table>

        <button @onclick="LoadExternalMaterial">
            加载料仓信息
        </button>


        <button @onclick="AgvToReady">
            Agv准备就绪
        </button>
    </p>
    <p>
        <table>
            <tr>
                <td><label>请输入移动的点位</label></td>
                <td>
                    <InputText @bind-Value=@currentContext.ToMovePos></InputText>
                </td>
                <td>
                    <p>休息点位：@agv.DeviceDescriptor.Extra["RestingPoints"].ToStr()</p>
                </td>
                <td>
                    <button @onclick="MoveToPos">
                        确认移动
                    </button>
                </td>
            </tr>
            <tr>
                <td><label>PLC点位 :</label></td>
                <td>
                    <InputText @bind-Value=@currentContext.PlcPoint></InputText>
                </td>
                <td><label>PLC 地址位数 :</label></td>
                <td>
                    <InputText @bind-Value=@currentContext.PlcLength></InputText>
                </td>
                <td>
                    <button @onclick="ReadPlc">
                        读取
                    </button>
                </td>
                <td><label>写入值 :</label></td>
                <td>
                    <InputText @bind-Value=@currentContext.PlcValue></InputText>
                </td>
                <td>
                    <button @onclick="WritePlc">
                        写入
                    </button>
                </td>
            </tr>
        </table>
    </p>
    <p>当前信息</p>
    <p @ref="messageElement">@currentContext.Message</p>
</EditForm>

