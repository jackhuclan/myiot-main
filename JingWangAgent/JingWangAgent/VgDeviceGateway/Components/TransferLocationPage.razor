@code {
    private ElementReference messageElement;
    private ElementReference transtextElement;
    private CentralWebOptions centralWebOptions;
    private List<MaterialModel> _rhModel = new List<MaterialModel> { new MaterialModel { Code = "" } };
    private List<string> SiloCodes { get; set; } = new List<string>() { "" };
    private string TransactionId = "";
    private string SensorNo = string.Empty;
    private string taskCode = string.Empty;
    private string hikTaskCode = string.Empty;
    private string material = string.Empty;
    private string SiloCode = string.Empty;
    private string bind = string.Empty;
    private string pcs = string.Empty;
    private string mapDataCode = string.Empty;
    private string shelfName = string.Empty;


    void UpdateValue(IHandleEvent? receiver, MulticastDelegate? de)
    {
        InvokeAsync(StateHasChanged);
    }

    private async void ReloadMaterialCodes()
    {
        // _rhModel.Clear();
        await transfer.GetPanelItemCodeAsync((QueryOrderByEnum)currentContext.ItemOrder, currentContext.MaterialMatchCode);
        // _rhModel.AddRange(_centralReporter.MaterialModels);
        OutputMessage($"获取物料代码成功，当前排序方式：{((QueryOrderByEnum)currentContext.ItemOrder).ToString()}", true);
        InvokeAsync(StateHasChanged);
        Show(true);
    }


    HikTransfer transfer;
    CurrentContext currentContext;
    LocationData<SiloShelf> currentLocation;
    JsonSerializerOptions Jsonoptions;

    protected override void OnAfterRender(bool firstRender)
    {
        centralWebOptions = options.Value;
    }

    private void ChageRack(ChangeEventArgs e)
    {
        transfer.ShelfIndex = (e.Value.ToInt() + 1).ToString();
        currentLocation = transfer.Locations[transfer.ShelfIndex];
        currentContext = currentLocation.CurrentContext;
        currentContext.RackIndex = e.Value.ToInt();
    }

    protected override void OnInitialized()
    {
        var deviceId = configuration.GetValue<string>("PageMasterDeviceId");
        transfer = deviceProvider.GetDevice(deviceId) as HikTransfer;

        if (transfer == null || !transfer.Locations.Any()) return;

        currentLocation = transfer.Locations[transfer.ShelfIndex];
        currentContext = currentLocation.CurrentContext;
        currentContext.RawPanelCount = transfer.DeviceDescriptor.LayerLimit.ToInt();

        Jsonoptions = new JsonSerializerOptions
            {
                Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping,
                WriteIndented = true
            };

        //  var timer = new Timer(_ =>
        // {
        //     OutputMessageTranc(_centralReporter.TransactionMessages);

        // }, null, 300, 1000 * 2);
        AddWatchProperty();
    }

    private void AddWatchProperty()
    {
        transfer.WatchingProperties.Property("TranscationChange")
        .When(p => p.NewValue.ToBool() == true)
        .TriggerAlways(() =>
        {
            StringBuilder sbl = new StringBuilder();
            foreach (var location in transfer.Locations.Values)
            {
                if (!string.IsNullOrWhiteSpace(location.TransactionMessage))
                    sbl.Append($"{location.TransactionMessage} \r\n");
            }

            OutputMessageTranc(sbl.ToString());
        });
    }

    private void Show(bool res)
    {
        if (res)
        {
            this.JSRuntime.InvokeVoidAsync("success");
        }
        else
        {
            this.JSRuntime.InvokeVoidAsync("fail");
        }
    }

    private async void OutputMessage(string message, bool reset = false)
    {
        message = $"{message}{Environment.NewLine}--{DateTime.Now.ToLocalTime()}";

        await this.JSRuntime.InvokeVoidAsync("setElementText1", messageElement, message);
    }

    private void OutputMessageTranc(string message)
    {
        //  this.JSRuntime.InvokeVoidAsync("UpdateInf", "transtext", message);
        this.JSRuntime.InvokeVoidAsync("setElementText1", transtextElement, message);
    }

    private async Task GetRackInfo()
    {
        var response = await transfer.GetRackInfo();

        OutputMessage($"PrepareLoadMaterial 函数执行结果: {JsonSerializer.Serialize(response)}", true);
    }

    private async Task ReloadSiloCodes()
    {
        if (SiloCodes == null)
            SiloCodes = new List<string>();
        else
            SiloCodes.Clear();
        SiloCodes.Add("");

        //var siloCodes = await transfer.GetSiloCodeAsync();
        var siloCodes = await transfer.GetSiloCodeAsync(currentContext.SiloMatch);
        SiloCodes.AddRange(siloCodes);
        transfer.SiloCodes = SiloCodes;
        OutputMessage("更新料仓编码成功", true);
        InvokeAsync(StateHasChanged);
        Show(true);
    }

    private async void PrepareLoadMaterial()
    {
        var response = await transfer.PrepareLoadMaterial(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
                Params = new Dictionary<string, object?>
                    {
                        { "SiloPosition",currentContext.RackIndex+1},

                    }
            });
        OutputMessage($"PrepareLoadMaterial 函数执行结果:【{response.Code}】 \r\n{response.Message}", true);

    }
    private async void CompleteLoadMaterial()
    {
        List<Panel> panels = new List<Panel>();
        for (int i = 0; i < transfer.DeviceDescriptor.LayerLimit.ToInt(); i++)
        {
            panels.Add(new Panel()
                {
                    BatchCode = "p1",
                    ItemCode = "item01",
                    PanelCode = "123456",
                    Position = currentContext.ShelfIndex,
                    Layer = i,

                });
        }

        var response = await transfer.CompleteLoadMaterial(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.COMPLETE_LOAD_MATERIAL_SERVICE_ID,
                Params = new Dictionary<string, object?>
                {
                    { "SiloPosition",currentContext.RackIndex+1},
                     { "LoadingPanel",new SwapPanel()
                        {
                          PanelList=panels
                        }
                     },
                     { "ShelfIndex",currentContext.RackIndex+1}
                },
                CallerRequestInputProductStatus = ProductStatus.PRE_POST_BUFFER_TRANSFER_AGV_OUTPUT_1
            });
        OutputMessage($"CompleteLoadMaterial 函数执行结果:【{response.Code}】\r\n{response.Message}", true);
        Show(true);
    }

    private async void PrepareUnloadMaterial()
    {
        var response = await transfer.PrepareUnloadMaterial(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
                Params = new Dictionary<string, object?>
                    {
                        { "SiloPosition",currentContext.RackIndex+1},

                    }
            });
        OutputMessage($"PrepareUnloadMaterial 函数执行结果:【{response.Code}】 \r\n{response.Message}", true);

    }
    private async void CompleteUnloadMaterial()
    {

        var response = await transfer.CompleteUnloadMaterial(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
                Params = new Dictionary<string, object?>
                    {
                        { "SiloPosition",currentContext.RackIndex+1},

                    }
            });
        OutputMessage($"CompleteUnloadMaterial 函数执行结果:【{response.Code}】 \r\n{response.Message}", true);
        Show(true);
    }


    private async Task EnsureNoSilo()
    {
        await transfer.Locations[(currentContext.ShelfIndex).ToStr()].SetNoPayload();
        QueryExternalMaterial();
    }

    private async void ResetAgvIsNotOnWorkSilo()
    {
        transfer.Locations[(currentContext.ShelfIndex).ToStr()].IsAgvWorking = false;
        OutputMessage($"ResetAgvIsNotOnWorkSilo 函数执行结果:【设置agv是否在给料架上料 false 】", true);
    }
    private async void ResetCallAgv()
    {
        var response = await transfer.CompleteSchedule(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
                EventId = $"event#{currentContext.ShelfIndex}",
                ScheduledStatus = VgAutoDrill.Fundation.Iot.Schedule.ScheduledTaskStatus.Canceled
            });
        OutputMessage($"ResetCallAgv 函数执行结果:【{response.Code}】", true);
    }

    private async void LoadExternalMaterial()
    {
        if (string.IsNullOrEmpty(currentContext.SiloCode))
        {
            OutputMessage("请选择料仓", true);
            return;
        }

        currentLocation.Panels.ForEach(p => p.SiloCode = currentContext.SiloCode);

        if (currentLocation.Panels.Count() == 0)
        {
            transfer.Locations[currentContext.ShelfIndex.ToString()].LoadPanels();
            //OutputMessage("板料不存在", true);
            //return;
        }

        var locationsWithSameSiloCode = transfer.Locations.Values.Where(x => x.CurrentContext.SiloCode == currentContext.SiloCode && x.LocationCode != currentContext.LocationCode);
        if (locationsWithSameSiloCode.Any())
        {
            OutputMessage($"{locationsWithSameSiloCode.First().LocationCode}已经设定了料仓号为{currentContext.SiloCode}", true);
            return;
        }

        if (currentContext.PanelType != 0 && string.IsNullOrEmpty(currentContext.ItemCode))
        {
            OutputMessage("请输入物料代码", true);
            return;
        }
        if (currentContext.PanelWidth > 625)
        {
            OutputMessage("请输入输入低于或等于625的板宽", true);
            return;
        }
        if (currentContext.StartLayer + currentContext.RawPanelCount > transfer.DeviceDescriptor.LayerLimit.ToInt())
        {
            OutputMessage($"层数+加载数量不能大于{transfer.DeviceDescriptor.LayerLimit.ToInt()}层", true);
            return;
        }

        transfer.Locations[(currentContext.ShelfIndex).ToStr()].UpdatePanelStatusFromEmptyPayloadToEmptySiloBox();

        var layer = currentContext.StartLayer;
        var productStatus = ProductStatus.EmptySiloBox;

        if (currentContext.PanelType == 1)
        {
            productStatus = ProductStatus.Finished_PRE_BUFFER;
        }
        else if (currentContext.PanelType == 2)
        {
            productStatus = ProductStatus.PRE_POST_BUFFER_TRANSFER_AGV_OUTPUT_1;
        }

        GetNextPanelRequest request = new GetNextPanelRequest()
            {
                BeginLayer = currentContext.StartLayer,
                Count = currentContext.RawPanelCount,
                ItemCode = currentContext.ItemCode,
                PanelWidth = currentContext.PanelWidth,
                PinOffset = currentContext.PinOffset,
                ProductStatus = productStatus,
                SiloCode = "",
                Position = 1,
                BatchCode = "",
                LotId = "",
            };

        var response = await httpRequestInvoker.PostAsJsonAsync<GetNextPanelRequest, List<Panel>>(transfer.DeviceDescriptor.Extra["GetNextPanelNumberV2"].ToStr(), request);

        //List<Panel?> panels = new List<Panel?>();
        var temp = transfer.Locations[currentContext.ShelfIndex.ToString()];
        for (var i = 0; i < currentContext.RawPanelCount; i++)
        // && response != null
        // && response.Count == currentContext.RawPanelCount
        {
            //var panel = transfer.Locations[currentContext.ShelfIndex.ToString()].Panels[i];
            var panel = temp.Panels[layer];
            var panelInf = Guid.NewGuid().ToString();
            if (response != null && response.Count > i)
            {
                panelInf = response[i].PanelCode;
            }

            if (currentContext.PanelType == 0)
            {
                panel.PanelCode = "";
                panel.ItemCode = "";
                panel.LocationCode = currentContext.LocationCode;
                panel.SiloCode = currentContext.SiloCode;
                panel.Layer = layer;
                panel.Position = currentContext.ShelfIndex;
                panel.BatchCode = "";
                panel.LotId = "";
                panel.PanelWidth = 0;
                panel.PinOffset = 0;
                panel.ProductStatus = productStatus;
                layer++;
            }
            else
            {

                panel.PanelCode = string.IsNullOrEmpty(currentLocation.Panels[layer].PanelCode) ? panelInf : currentLocation.Panels[layer].PanelCode;
                panel.Barcode = string.IsNullOrEmpty(currentLocation.Panels[layer].Barcode) ? panelInf : currentLocation.Panels[layer].Barcode;
                panel.ItemCode = currentContext.ItemCode;
                panel.LocationCode = currentContext.LocationCode;
                panel.SiloCode = currentContext.SiloCode;
                panel.Layer = layer;
                panel.Position = currentContext.ShelfIndex;
                panel.BatchCode = "";
                panel.LotId = "";
                panel.Pcs = currentContext.Pcs;
                panel.PanelWidth = currentContext.PanelWidth;
                panel.PinOffset = 0;
                panel.ProductStatus = productStatus;

                layer++;
            }
        }

        //transfer.Locations[(currentContext.ShelfIndex).ToStr()].UpdateSiloInfoByPositionAndIndex(currentContext.StartLayer, panels);
        transfer.Locations[currentContext.ShelfIndex.ToString()].SavePanels();
        //transfer.setNewPanelLog(transfer.Locations[currentContext.ShelfIndex.ToString()].Panels, (currentContext.ShelfIndex).ToString());
        transfer.setNewPanelLog(temp.Panels, (currentContext.ShelfIndex).ToString());
        QueryExternalMaterial();
    }

    private void QueryExternalMaterial()
    {
        // var shelfIndex = currentContext.ShelfIndex;
        // var allstr = $"第{shelfIndex}号料架" + Environment.NewLine; ;
        // for (int i = currentContext.RackIndex * _centralReporter.DeviceDescriptor.LayerLimit; i < currentContext.RackIndex * _centralReporter.DeviceDescriptor.LayerLimit + _centralReporter.DeviceDescriptor.LayerLimit; i++)
        // {
        //     allstr += $"第{i + 1 - _centralReporter.layerLimit * currentContext.RackIndex}层：{Newtonsoft.Json.JsonConvert.SerializeObject(_centralReporter.PayloadPanels[i])} {Environment.NewLine}";
        // }

        // OutputMessage(allstr, true);
        // Show(true);

        QueryLocationPanels();
    }

    private void QueryLocationPanels()
    {
        var shelfIndex = currentContext.ShelfIndex;
        var allstr = $"第{shelfIndex}号料架" + Environment.NewLine;
        var panels = transfer.Locations[(currentContext.ShelfIndex).ToStr()].Panels;

        for (int i = 0; i < panels.Count; i++)
        {
            //allstr += $"第{i + 1}层：{Newtonsoft.Json.JsonConvert.SerializeObject(panels[i])} {Environment.NewLine}";
            string status = GetPanelOrSiloStstus( panels[i].ProductStatus);
            allstr += $"第{i + 1}层：料仓号:{panels[i].SiloCode ?? ""}， 料号:{panels[i].ItemCode ?? ""}， 位置:{panels[i].LocationCode ?? ""}， 板料状态：{status}， 片数：{(int)panels[i].Pcs}， 是否首件：{panels[i].IsFirst}{Environment.NewLine}";
        }
        OutputMessage(allstr, true);
        Show(true);
    }

    public string GetPanelOrSiloStstus(ProductStatus status)
    {
        string res = "";
        if (ProductStatusConstants.EmptySiloBox.Contains(status))
        {
            res = "空料仓";
        }
        else if (ProductStatusConstants.EmptyPayload.Contains(status))
        {
            res = "无料仓";
        }
        else if (ProductStatusConstants.Finished_PIN.Contains(status))
        {
            res = "生料";
        }
        else if (ProductStatusConstants.Finished_DRILL.Contains(status))
        {
            res = "熟料";
        }
        else
        {
            res = "异常";
        }
        return res;
    }

