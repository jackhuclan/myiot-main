    private async void SetReady()
    {
        var response = await transfer.WriteProperties(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
            });

        var location = transfer.Locations[(currentContext.ShelfIndex).ToStr()];
        if (!location.Panels.IsEmptyPayload
            && string.IsNullOrWhiteSpace(location.Panels.SiloCode))
        {
            OutputMessage($"不是空料仓的情况下，必须设定料仓号", true);
            Show(true);
            return;
        }

        location.IsReady = true;
        logger.LogInformation($"Trace_Ready : SetReady: 人工设置了 {location.LocationCode}: Ready=true");
        location.CurrentContext.isReady = true;
        OutputMessage(response.Message + $"是否Ready {currentContext.isReady}", true);
        Show(true);
    }

    private async void SetAllReady()
    {
        var response = await transfer.WriteProperties(new DeviceServiceInvokeRequest
            {
                ProductId = transfer.ProductId,
                DeviceId = transfer.DeviceId,
                ServiceId = Topics.Services.PROPERTIES_WRITE_SERVICE_ID,
            });

        foreach (var location in transfer.Locations.Values)
        {
            if (!location.Panels.IsEmptyPayload
            && string.IsNullOrWhiteSpace(location.Panels.SiloCode))
            {
                OutputMessage($"{location.LocationCode}不是空料仓的情况下，必须设定料仓号", true);
                Show(true);
                return;
            }

            location.IsReady = true;
            logger.LogInformation($"Trace_Ready : SetAllReady: 人工设置了 {location.LocationCode}  Ready=true");
            location.CurrentContext.isReady = true;
        }

        OutputMessage(response.Message + $"已全部设置Ready", true);
        Show(true);
    }
    private async void ResetAllCallAgv()
