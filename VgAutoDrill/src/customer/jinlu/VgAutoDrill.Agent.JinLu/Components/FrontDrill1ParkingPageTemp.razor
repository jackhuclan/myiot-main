<p @ref="messageElement">@currentContext.Message</p>
@code {
    private Timer timer;
    private ElementReference messageElement;
    public class CurrentContext
    {
        public string Message { get; set; } = "";
    }
    private CurrentContext currentContext = new CurrentContext();
    private async void QueryExternalMaterial()
    {
        //ShowPanel($"检测门是否已打开，或者气压是否正常：{await DrillDevice.ValidateDoorOpen()} \r\n料仓信息：{JsonSerializer.Serialize(DrillDevice.PayloadPanels)}", true);
    }
    
    private async void ShowPanel(string message, bool reset = false)
    {
        if (reset) currentContext.Message = $"{message}--{DateTime.Now.ToLocalTime()}";
        else currentContext.Message = $"{currentContext.Message}{Environment.NewLine}{message}--{DateTime.Now.ToLocalTime()}";

        await this.JSRuntime.InvokeVoidAsync("handleRequestMaterial", messageElement, currentContext.Message);
    }

    private VgAutoDrill.Fundation.Vendor.Vega.FrontDrill1ParkingTemp DrillDevice;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        if (deviceProvider.Devices.Count == 1)
        {
            DrillDevice = deviceProvider.Devices[0] as VgAutoDrill.Fundation.Vendor.Vega.FrontDrill1ParkingTemp;

            timer = new System.Threading.Timer(_ =>
                {
                    InvokeAsync(QueryExternalMaterial);
                    InvokeAsync(StateHasChanged);
                }, null, 500, 1000);

        }
        else
        {
            OutputMessage($"没有可用的设备或者设备不唯一");
        }
    }

    public class FrontDrill1ParkingPageTempContext
