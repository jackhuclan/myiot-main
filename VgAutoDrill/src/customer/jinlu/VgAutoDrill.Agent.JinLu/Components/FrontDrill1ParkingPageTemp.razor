<h3>FrontDrill1ParkingTemp</h3>

<p>
    <EditForm Model="@frontDrill1ParkingPageTempContext">
        <InputSelect @bind-Value=@frontDrill1ParkingPageTempContext.splineNum>
            <option value="1">1号轴</option>
            <option value="2">2号轴</option>
            <option value="3">3号轴</option>
            <option value="4">4号轴</option>
            <option value="5">5号轴</option>
            <option value="6">6号轴</option>
        </InputSelect>&nbsp;&nbsp;
    </EditForm>
</p>
<p id="text">@message</p>



<p>

    <button @onclick="PrepareUnloadMaterial">
        下料前准备
    </button>

    <br />
    <br />
