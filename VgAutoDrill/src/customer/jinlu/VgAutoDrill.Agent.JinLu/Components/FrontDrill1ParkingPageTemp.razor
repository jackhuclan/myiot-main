    private async void PrepareUnloadMaterial()
    {
        logger.LogDebug("FrontDrill1Parking PrepareUnloadMaterial...");
        OutputMessage($"PrepareUnloadMaterial 函数 开始执行");
        if (deviceProvider.Devices.Count == 1)
        {
            var device = deviceProvider.Devices[0]; //("FrontDrill1001");
            var response = await device.PrepareUnloadMaterial(new Fundation.Iot.Models.DeviceServiceInvokeRequest
                {
                    ProductId = device.ProductId,
                    DeviceId = device.DeviceId,
                    ServiceId = Topics.Services.PREPARE_UNLOAD_MATERIAL_SERVICE_ID,
                    Params = new Dictionary<string, object?>
                    {

                    }
                });
            OutputMessage($"PrepareUnloadMaterial 函数执行结果:【{response.Code}】");
        }
        else
        {
            OutputMessage($"没有可用的设备或者设备不唯一");
        }
    }

