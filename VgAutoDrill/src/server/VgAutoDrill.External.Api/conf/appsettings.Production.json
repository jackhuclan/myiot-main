  "ClickhouseOptions": {
    "ConnectionString": "Host=Clickhouse;Port=8123;Database=vg_autodrill_db_ck;User=default;Password=",

    "Compression": true,
    "Session": false,
    "CustomDecimals": true
  },
  "ExternalOptions": {
    "EnableAutoImportJiangXiKinWong": false,
    "DirectBuildTask": true
