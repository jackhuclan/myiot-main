    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "VgAutoDrill.DataCollect": "Warning"
    },
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning",
        "VgAutoDrill.DataCollect": "Warning"
      },
      "FormatterName": "Simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": true,
        "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
      }
    }
  },
  "ConnectionStrings": {
    "DbType": "MySql",
    "VgAutoDrillAuthDB": "server=mysql;Database=vg_autodrill_db;Uid=root;Pwd=123456;SslMode=none;"
