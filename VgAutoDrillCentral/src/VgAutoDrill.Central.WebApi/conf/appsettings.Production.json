{
    "MaxHttpCollectionKeys": 20000,
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "VgAutoDrill.DataCollect": "Warning"
        },
        "Console": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft": "Warning",
                "VgAutoDrill.DataCollect": "Warning"
            },
            "FormatterName": "Simple",
            "FormatterOptions": {
                "SingleLine": true,
                "IncludeScopes": true,
                "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
            }
        }
    },
    "PluginSetupOptions": [
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.AjwAgv.dll",
            "PluginName": "AjwAgvPluginSetup",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.HikAgv.dll",
            "PluginName": "HikAgvPluginSetup",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.StdAgv.dll",
            "PluginName": "StdAgvPluginSetup",
            "Enabled": false
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.Bomin.dll",
            "PluginName": "BominPluginSetup",
            "Enabled": false
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.ShenzhenKinwong.dll",
            "PluginName": "KingwongPluginSetup",
            "Enabled": false
        }
    ],
    "MysqlTaskSchedulerOptions": {
        "ConsumingPerSeconds": 5,
        "SystemRefreshInterval": 5,
        "EnablePersistPanelsToDb": false,
        "IsUrgentSchedulePreferred": true,
        "EnableSiloStatusAutoControl": true,
        "EnableUnpinLoadRequestByItem": true,
        "EnableAutoSetAgvRestPoint": false, /*崇达，是否自动分配休息点*/
        "TransferOptions": [
            {
                "PartitionKind": "1", //1私有分区,2公共分区
                "TransferMode": 0,
                "EnableDrilledTrackOut": true,
                "EnableDrilledTrackIn": false,
                "EnableUndrilledTrackOut": false,
                "EnableUndrilledTrackIn": true,
                "EnableEmptyBoxTrackOut": true,
                "EnableEmptyBoxTrackIn": true,
                "EnableFirstTrackOut": false,
                "EnableFirstTrackIn": false
            }
        ]
    },
    "ConnectionStrings": {
        "DbType": "MySql",
        "VgAutoDrillAuthDB": "server=mysql;Port=3306;Database=vg_autodrill_db;Uid=root;Pwd=123456;Pooling=true;SslMode=none;AllowPublicKeyRetrieval=True;Max Pool Size=200;",
        "VgAutoDrillSlave1": "",
        "VgAutoDrillSlave2": ""
    },
    "AppConfig": {
        "PortMqtt": 1883,
        "PortCentral": 8001,
        "MinThreads": 200,
        "CompletionPortThreads": 200
    },
    "ZipkinEndpoint": "http://localhost:9411/api/v2/spans",
    "ClickHouseOptions": {
        "ConnectionString": "Compress=False;BufferSize=32768;SocketTimeout=10000;CheckCompressedHash=False;Compressor=lz4;Host=ClickHouse;Port=8123;Database=vg_autodrill_db_ck;User=default;Password=",
        "Compression": true,
        "Session": false,
        "CustomDecimals": true
    },
    "DeviceAlarmListenerOptions": {
        "Enabled": false,
        "PrefetchCount": 100,
        "PrefetchInterval": 5,
        "PrefetchDays": 7
    },
    "DeviceServiceInvocationReplayerOptions": {
        "MaxRetries": 3,
        "PrefetchInterval": 2
    },
    "RedisCacheOptions": {
        "ConnectionString": "Redis:6379,abortConnect=false,connectTimeout=5000,connectRetry=3,syncTimeout=5000,DefaultDatabase=1,password=123456",
        "InstanceName": "central"
    },
    "RedisConfig": {
        "RedisUseCache": true,
        "ConnectionString": "Redis:6379,abortConnect=false,connectTimeout=5000,connectRetry=3,syncTimeout=5000,DefaultDatabase=10,password=123456"
    },
    "AllowedHosts": "*"
}
