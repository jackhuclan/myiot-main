{
    "MaxHttpCollectionKeys": 20000,
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "VgAutoDrill.DataCollect": "Warning"
        },
        "Console": {
            "LogLevel": {
                "Default": "Debug",
                "Microsoft": "Warning",
                "VgAutoDrill.DataCollect": "Warning",
                "VgAutoDrill.Central.Core.DeviceProxy": "Information"
            },
            "FormatterName": "Simple",
            "FormatterOptions": {
                "SingleLine": true,
                "IncludeScopes": true,
                "TimestampFormat": "[yyyy-MM-dd HH:mm:ss] "
            }
        }
    },
    "PluginSetupOptions": [
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.AjwAgv.dll",
            "PluginName": "AjwAgvPluginSetup",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.HikAgv.dll",
            "PluginName": "HikAgvPluginSetup",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.StdAgv.dll",
            "PluginName": "StdAgvPluginSetup",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.XianJin.dll",
            "PluginName": "XianJinPlugin",
            "Enabled": true
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.Bomin.dll",
            "PluginName": "BominPluginSetup",
            "Enabled": false
        },
        {
            "PluginDirectory": ".",
            "AssemblyFileName": "VegaIot.External.ShenzhenKinwong.dll",
            "PluginName": "KingwongPluginSetup",
            "Enabled": false
        }
