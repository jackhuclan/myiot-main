    "ConnectionStrings": {
        "DbType": "MySql",
        //"VgAutoDrillAuthDB": "server=192.168.102.178;Port=3306;Database=vg_autodrill_db;Uid=root;Pwd=123456;SslMode=none;AllowPublicKeyRetrieval=True;Max Pool Size=200;",
        "VgAutoDrillAuthDB": "server=127.0.0.1;Port=3306;Database=vg_autodrill_db;Uid=root;Pwd=123456;SslMode=none;AllowPublicKeyRetrieval=True;Max Pool Size=200;",
        "VgAutoDrillSlave1": "",
        "VgAutoDrillSlave2": ""
    },
    "AppConfig": {
        "PortMqtt": 1883,
        "PortCentral": 8001
    },
    "ZipkinEndpoint": "http://localhost:9411/api/v2/spans",
    "ClickHouseOptions": {
        //"ConnectionString": "Compress=False;BufferSize=32768;SocketTimeout=10000;CheckCompressedHash=False;Compressor=lz4;Host=127.0.0.1;Port=8123;Database=vg_autodrill_db_ck;User=default;Password=",
