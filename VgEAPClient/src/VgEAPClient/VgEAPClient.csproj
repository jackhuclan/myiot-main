<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <PackageIcon>App.ico</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="NLog.config" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="genesis.ensure" Version="2.0.0" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="8.0.14" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="SuperSocket.ClientEngine.Core" Version="0.10.0" />
    <PackageReference Include="OswaldTechnologies.Extensions.Hosting.WindowsFormsLifetime" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin\VgAOI.Plugin\VgAOI.Plugin.csproj" />
    <ProjectReference Include="..\Plugin\VgEAPClient.Recipe.Bomin\VgEAPClient.Recipe.Bomin.csproj" />
    <ProjectReference Include="..\Plugin\VgEAPClient.Recipe.Everything64\VgEAPClient.Recipe.Everything64.csproj" />
    <ProjectReference Include="..\Plugin\VgEAPClient.Recipe.JiangZhouChongDa\VgEAPClient.Recipe.JiangZhouChongDa.csproj" />
    <ProjectReference Include="..\Plugin\VgEAPClient.Recipe.JingPeng\VgEAPClient.Recipe.JingPeng.csproj" />
    <ProjectReference Include="..\VegaUI\VegaUI.csproj" />
    <ProjectReference Include="..\VgCNCServer.DAO\VgCNCServer.DAO.csproj" />
    <ProjectReference Include="..\VgEAPClient.Common\VgEAPClient.Common.csproj" />
    <ProjectReference Include="..\VgEAPClient.HttpDrillInfoLocator\VgEAPClient.Recipe.WebAPI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.IWshRuntimeLibrary">
      <HintPath>Interop.IWshRuntimeLibrary.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resource.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resource.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resource.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="App.ico">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="autostart.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>